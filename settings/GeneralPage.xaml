<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="StatletSettings.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="4">
        <TextBlock Text="General" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,24" />

        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE7E8;" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Start with Windows" Style="{StaticResource RowTitle}" />
                <TextBlock Text="The island opens when you sign in" Style="{StaticResource RowDesc}" />
            </StackPanel>
            <ToggleSwitch x:Name="Startup" Grid.Column="2" OnContent="On" OffContent="Off" MinWidth="0" Toggled="OnStartup"
                          AutomationProperties.Name="Start with Windows" />
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0,0,8">
            <TextBlock x:Name="StartupNote" Style="{StaticResource RowDesc}" VerticalAlignment="Center" />
            <HyperlinkButton x:Name="StartupApps" Content="Open Startup Apps" NavigateUri="ms-settings:startupapps" Padding="0" Visibility="Collapsed" />
        </StackPanel>
        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE740;" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Distance from the top" Style="{StaticResource RowTitle}" />
                <TextBlock Text="Space between the island and the top of the screen" Style="{StaticResource RowDesc}" />
            </StackPanel>
            <Slider Grid.Column="2" Width="200" Minimum="0" Maximum="48" StepFrequency="1" VerticalAlignment="Center"
                    Value="{x:Bind S.TopOffset, Mode=TwoWay}" AutomationProperties.Name="Distance from the top" />
            <TextBlock Grid.Column="3" Style="{StaticResource Value}" Text="{x:Bind Px(S.TopOffset), Mode=OneWay}" />
        </Grid>

        <TextBlock Text="Focus timer" Style="{StaticResource Section}" />
        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE916;" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Focus length" Style="{StaticResource RowTitle}" />
                <TextBlock Text="Start a session from the tray icon. The time left sits next to the clock." Style="{StaticResource RowDesc}" />
            </StackPanel>
            <ComboBox x:Name="FocusLength" Grid.Column="2" MinWidth="150" VerticalAlignment="Center" SelectionChanged="OnFocus"
                      AutomationProperties.Name="Focus length" />
        </Grid>

        <TextBlock Text="CPU and memory" Style="{StaticResource Section}" />
        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE7BA;" Foreground="#FFB020" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Warning at" Style="{StaticResource RowTitle}" />
                <TextBlock Text="Bars turn amber and show a warning mark" Style="{StaticResource RowDesc}" />
            </StackPanel>
            <Slider Grid.Column="2" Width="200" Minimum="50" Maximum="95" StepFrequency="1" VerticalAlignment="Center"
                    Value="{x:Bind S.WarnAt, Mode=TwoWay}" AutomationProperties.Name="Warning at" />
            <TextBlock Grid.Column="3" Style="{StaticResource Value}" Text="{x:Bind Pct(S.WarnAt), Mode=OneWay}" />
        </Grid>
        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xEA39;" Foreground="#FF5A52" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Critical at" Style="{StaticResource RowTitle}" />
                <TextBlock Text="Bars turn red. Always at least 5% above the warning." Style="{StaticResource RowDesc}" />
            </StackPanel>
            <Slider Grid.Column="2" Width="200" Minimum="{x:Bind CritMin(S.WarnAt), Mode=OneWay}" Maximum="100" StepFrequency="1" VerticalAlignment="Center"
                    Value="{x:Bind S.CritAt, Mode=TwoWay}" AutomationProperties.Name="Critical at" />
            <TextBlock Grid.Column="3" Style="{StaticResource Value}" Text="{x:Bind Pct(S.CritAt), Mode=OneWay}" />
        </Grid>
        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE9D9;" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Open the island when usage stays high" Style="{StaticResource RowTitle}" />
                <TextBlock Text="Above 90% for 30 seconds, it opens and shows the numbers" Style="{StaticResource RowDesc}" />
            </StackPanel>
            <ToggleSwitch Grid.Column="2" OnContent="On" OffContent="Off" MinWidth="0" IsOn="{x:Bind S.OpenOnHighUsage, Mode=TwoWay}"
                          AutomationProperties.Name="Open the island when usage stays high" />
        </Grid>

        <TextBlock Text="Rest line" Style="{StaticResource Section}" />
        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE787;" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Show weekday" Style="{StaticResource RowTitle}" />
                <TextBlock Text="Thu Nov 13 beside the time" Style="{StaticResource RowDesc}" />
            </StackPanel>
            <ToggleSwitch Grid.Column="2" OnContent="On" OffContent="Off" MinWidth="0" IsOn="{x:Bind S.ShowWeekday, Mode=TwoWay}"
                          AutomationProperties.Name="Show weekday" />
        </Grid>
        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE702;" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Bluetooth icon" Style="{StaticResource RowTitle}" />
                <TextBlock Text="A Bluetooth icon shows for 3 seconds when a paired device connects" Style="{StaticResource RowDesc}" />
            </StackPanel>
            <ToggleSwitch Grid.Column="2" OnContent="On" OffContent="Off" MinWidth="0" IsOn="{x:Bind S.BtIcon, Mode=TwoWay}"
                          AutomationProperties.Name="Bluetooth icon" />
        </Grid>
        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE896;" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Download icon" Style="{StaticResource RowTitle}" />
                <TextBlock Text="A download icon shows while a file downloads into your Downloads folder" Style="{StaticResource RowDesc}" />
            </StackPanel>
            <ToggleSwitch Grid.Column="2" OnContent="On" OffContent="Off" MinWidth="0" IsOn="{x:Bind S.DownloadIcon, Mode=TwoWay}"
                          AutomationProperties.Name="Download icon" />
        </Grid>
        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE8CB;" VerticalAlignment="Top" Margin="0,4,0,0" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Order" Style="{StaticResource RowTitle}" />
                <TextBlock Text="Drag a row, or select it and use the buttons. Music keeps framing the date and bars." Style="{StaticResource RowDesc}" />
                <ListView x:Name="OrderList" SelectionMode="Single" CanReorderItems="True" AllowDrop="True" Margin="0,8,0,0" Width="260" HorizontalAlignment="Left"
                          DragItemsCompleted="OnOrderDragged" SelectionChanged="OnOrderSelected" AutomationProperties.Name="Rest line order" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                <Button x:Name="OrderUp" Click="OnOrderUp" IsEnabled="False" AutomationProperties.Name="Move up">
                    <FontIcon Glyph="&#xE70E;" FontSize="14" />
                </Button>
                <Button x:Name="OrderDown" Click="OnOrderDown" IsEnabled="False" AutomationProperties.Name="Move down">
                    <FontIcon Glyph="&#xE70D;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <TextBlock Text="Sounds" Style="{StaticResource Section}" />
        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE722;" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Screenshot taken" Style="{StaticResource RowTitle}" />
                <TextBlock Text="Plays your Windows notification sound" Style="{StaticResource RowDesc}" />
            </StackPanel>
            <ToggleSwitch Grid.Column="2" OnContent="On" OffContent="Off" MinWidth="0" IsOn="{x:Bind S.SoundScreenshot, Mode=TwoWay}"
                          AutomationProperties.Name="Sound when a screenshot is taken" />
        </Grid>
        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE73E;" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Download finished" Style="{StaticResource RowTitle}" />
                <TextBlock Text="Plays your Windows notification sound" Style="{StaticResource RowDesc}" />
            </StackPanel>
            <ToggleSwitch Grid.Column="2" OnContent="On" OffContent="Off" MinWidth="0" IsOn="{x:Bind S.SoundDownloadDone, Mode=TwoWay}"
                          AutomationProperties.Name="Sound when a download finishes" />
        </Grid>
        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE916;" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Focus timer finished" Style="{StaticResource RowTitle}" />
                <TextBlock Text="Plays your Windows reminder sound" Style="{StaticResource RowDesc}" />
            </StackPanel>
            <ToggleSwitch Grid.Column="2" OnContent="On" OffContent="Off" MinWidth="0" IsOn="{x:Bind S.SoundFocusDone, Mode=TwoWay}"
                          AutomationProperties.Name="Sound when the focus timer finishes" />
        </Grid>

        <TextBlock Text="Changes apply to the island right away. There is no Save button." Style="{StaticResource RowDesc}" Margin="0,24,0,0" />
    </StackPanel>
</UserControl>
