<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="StatletSettings.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="4">
        <TextBlock Text="About" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,24" />

        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE946;" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="VersionText" Style="{StaticResource RowTitle}" />
                <TextBlock x:Name="InstalledText" Style="{StaticResource RowDesc}" />
            </StackPanel>
        </Grid>
        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE774;" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Releases" Style="{StaticResource RowTitle}" />
                <TextBlock Text="Opens GitHub in your browser. Statlet itself never goes online." Style="{StaticResource RowDesc}" />
            </StackPanel>
            <Button Grid.Column="2" Content="Releases page" Click="OnReleases" VerticalAlignment="Center" />
            <Button Grid.Column="3" Content="Release notes" Click="OnNotes" VerticalAlignment="Center" />
        </Grid>
        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xEA8F;" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Get told about new versions" Style="{StaticResource RowTitle}" />
                <TextBlock Text="On GitHub, choose Watch, then Custom, then Releases. Or follow the releases feed in a feed reader." Style="{StaticResource RowDesc}" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
