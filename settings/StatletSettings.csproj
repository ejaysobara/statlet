<?xml version="1.0" encoding="utf-8"?>
<!-- Statlet's settings app: WinUI 3, unpackaged and self-contained, opened from the island's tray menu.
     `dotnet publish -c Release -r win-x64 -o ..\island\out\settings` puts it where the island launches it. -->
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
        <OutputType>WinExe</OutputType>
        <Version>$([System.IO.File]::ReadAllText("$(MSBuildThisFileDirectory)..\VERSION").Trim())</Version>  <!-- the repo's one version number -->
        <UseWinUI>true</UseWinUI>
        <WindowsPackageType>None</WindowsPackageType>
        <EnableMsixTooling>true</EnableMsixTooling>  <!-- without it, publish leaves out the compiled XAML (.xbf, .pri) -->
        <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
        <SelfContained>true</SelfContained>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>StatletSettings</RootNamespace>
        <AssemblyName>StatletSettings</AssemblyName>
        <Platforms>x64;ARM64</Platforms>
        <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Assets\statlet-app.ico</ApplicationIcon>
        <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>  <!-- Program.cs is the entry point -->
        <StartupObject>StatletSettings.Program</StartupObject>
    </PropertyGroup>
    <ItemGroup>
        <Content Include="Assets\Manrope.ttf" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="Assets\statlet-app.ico" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="Assets\statlet-app.png" CopyToOutputDirectory="PreserveNewest" />
        <Manifest Include="$(ApplicationManifest)" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
        <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    </ItemGroup>
</Project>
