<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="StatletSettings.AppearancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="IslandText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IslandFont}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#F5F6F8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Chip" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
            <Setter Property="MinWidth" Value="64" />
        </Style>
        <Style x:Key="Swatch" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="20" />
        </Style>
    </UserControl.Resources>
    <!-- The preview stays in view while the controls under it scroll -->
    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="Appearance" Style="{StaticResource TitleTextBlockStyle}" />
            <Button Grid.Column="1" Click="OnReset">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="Reset to default" />
                </StackPanel>
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="8">
            <Grid CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid.RowDefinitions><RowDefinition Height="248" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid x:Name="Stage" Background="#283044">
                    <Ellipse x:Name="BlobA" Width="360" Height="360" Fill="#3F5A7A" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="60,40,0,0" />
                    <Ellipse x:Name="BlobB" Width="280" Height="280" Fill="#6B4A6E" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-60,120,0" />
                    <Border x:Name="Island" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0" Width="176" Height="34"
                            BorderBrush="#24FFFFFF" BorderThickness="1" AutomationProperties.Name="Island preview">
                        <Border.Background>
                            <AcrylicBrush x:Name="Glass" TintColor="#1C1E24" TintOpacity="0.52" TintLuminosityOpacity="0.65" FallbackColor="#F01C1E24" />
                        </Border.Background>
                        <Grid>
                            <StackPanel x:Name="RestFace" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <TextBlock x:Name="RestFocus" Text="Focus 18m" Style="{StaticResource IslandText}" />
                                <TextBlock x:Name="RestTime" Text="9:41" Style="{StaticResource IslandText}" FontWeight="Normal" Foreground="#9EF5F6F8" />
                                <StackPanel Spacing="3" VerticalAlignment="Center">
                                    <Border Width="26" Height="4" CornerRadius="2" Background="#33F5F6F8"><Border x:Name="RestCpu" Width="11" HorizontalAlignment="Left" CornerRadius="2" /></Border>
                                    <Border Width="26" Height="4" CornerRadius="2" Background="#33F5F6F8"><Border x:Name="RestRam" Width="16" HorizontalAlignment="Left" CornerRadius="2" /></Border>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel x:Name="HoverFace" Padding="14" Spacing="8" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="CpuLabel" Text="CPU" Width="30" Style="{StaticResource IslandText}" Foreground="#9EF5F6F8" />
                                    <Border Width="134" Height="6" CornerRadius="3" Background="#33F5F6F8" VerticalAlignment="Center"><Border x:Name="HoverCpu" Width="56" HorizontalAlignment="Left" CornerRadius="3" /></Border>
                                    <TextBlock x:Name="CpuValue" Text="42%" Style="{StaticResource IslandText}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="RamLabel" Text="RAM" Width="30" Style="{StaticResource IslandText}" Foreground="#9EF5F6F8" />
                                    <Border Width="134" Height="6" CornerRadius="3" Background="#33F5F6F8" VerticalAlignment="Center"><Border x:Name="HoverRam" Width="84" HorizontalAlignment="Left" CornerRadius="3" /></Border>
                                    <TextBlock x:Name="RamValue" Text="63%" Style="{StaticResource IslandText}" />
                                </StackPanel>
                            </StackPanel>
                            <Grid x:Name="CardFace" Padding="18,16" RowSpacing="10" Visibility="Collapsed">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <!-- As the island's card (ShowCard in island/src/main.cpp): icon and title, the device on the title's line, a 280 bar and its value -->
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon x:Name="CardIcon" Glyph="&#xE767;" FontSize="16" />
                                    <TextBlock x:Name="CardTitle" Grid.Column="1" Text="Volume" Style="{StaticResource IslandText}" FontWeight="Bold" />
                                    <TextBlock x:Name="CardDetail" Grid.Column="2" Text="Speakers (Realtek(R) Audio)" Style="{StaticResource IslandText}" FontWeight="Normal"
                                               Foreground="#9EF5F6F8" MaxWidth="180" HorizontalAlignment="Right" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <Grid Grid.Row="1" VerticalAlignment="Bottom">
                                    <Border Width="280" Height="6" CornerRadius="3" Background="#33F5F6F8" HorizontalAlignment="Left" VerticalAlignment="Center"><Border x:Name="CardBar" Width="179" HorizontalAlignment="Left" CornerRadius="3" /></Border>
                                    <TextBlock x:Name="CardValue" Text="64%" Style="{StaticResource IslandText}" HorizontalAlignment="Right" />
                                </Grid>
                            </Grid>
                            <StackPanel x:Name="MediaFace" Padding="18,16" Spacing="14" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <Border x:Name="MediaArt" Width="62" Height="62" CornerRadius="14" Background="#C9603A" />
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock x:Name="MediaTitle" Text="Northern Lights" Style="{StaticResource IslandText}" FontWeight="Bold" />
                                        <TextBlock x:Name="MediaArtist" Text="Aurora Field" Style="{StaticResource IslandText}" FontWeight="Normal" Foreground="#9EF5F6F8" />
                                    </StackPanel>
                                </StackPanel>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="MediaElapsed" Text="1:12" Style="{StaticResource IslandText}" Foreground="#9EF5F6F8" />
                                    <Border Grid.Column="1" Height="6" CornerRadius="3" Background="#33F5F6F8" VerticalAlignment="Center"><Border x:Name="MediaBar" Width="130" HorizontalAlignment="Left" CornerRadius="3" /></Border>
                                    <TextBlock x:Name="MediaLeft" Grid.Column="2" Text="-2:12" Style="{StaticResource IslandText}" Foreground="#9EF5F6F8" />
                                </Grid>
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left">
                                        <TextBlock Text="CPU" Style="{StaticResource IslandText}" FontSize="11" Foreground="#9EF5F6F8" />
                                        <Border Width="30" Height="4" CornerRadius="2" Background="#33F5F6F8" VerticalAlignment="Center"><Border x:Name="MediaCpu" Width="13" HorizontalAlignment="Left" CornerRadius="2" /></Border>
                                        <TextBlock Text="42%" Style="{StaticResource IslandText}" FontSize="11" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                        <TextBlock Text="RAM" Style="{StaticResource IslandText}" FontSize="11" Foreground="#9EF5F6F8" />
                                        <Border Width="30" Height="4" CornerRadius="2" Background="#33F5F6F8" VerticalAlignment="Center"><Border x:Name="MediaRam" Width="19" HorizontalAlignment="Left" CornerRadius="2" /></Border>
                                        <TextBlock Text="63%" Style="{StaticResource IslandText}" FontSize="11" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
                <Grid Grid.Row="1" Padding="12,8" ColumnSpacing="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="View" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ToggleButton x:Name="ViewRest" Content="Resting" Tag="0" Style="{StaticResource Chip}" Click="OnView" />
                        <ToggleButton Content="Hover" Tag="1" Style="{StaticResource Chip}" Click="OnView" />
                        <ToggleButton Content="Card" Tag="2" Style="{StaticResource Chip}" Click="OnView" />
                        <ToggleButton Content="Music" Tag="3" Style="{StaticResource Chip}" Click="OnView" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Wallpaper" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ToggleButton x:Name="WallDark" Content="Dark" IsChecked="True" Style="{StaticResource Chip}" Click="OnWall" />
                        <ToggleButton x:Name="WallLight" Content="Light" Style="{StaticResource Chip}" Click="OnWall" />
                    </StackPanel>
                </Grid>
            </Grid>
            <TextBlock Text="The island at the top of your screen changes with you, and holds the view you pick while this page is open."
                       Style="{StaticResource RowDesc}" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" Margin="0,8,-24,0" Padding="0,0,24,0">
            <StackPanel Spacing="4" Padding="0,0,0,24">
                <TextBlock Text="Glass" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,6" />
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Tint" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="The color behind the frosted glass" Style="{StaticResource RowDesc}" />
                    </StackPanel>
                    <StackPanel x:Name="Tints" Grid.Column="1" Orientation="Horizontal" Spacing="6" AutomationProperties.Name="Tint" />
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Tint strength" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="Lower shows more of what is behind the island" Style="{StaticResource RowDesc}" />
                    </StackPanel>
                    <Slider Grid.Column="1" Width="200" Minimum="0.2" Maximum="1" StepFrequency="0.01" VerticalAlignment="Center"
                            Value="{x:Bind S.TintOpacity, Mode=TwoWay}" AutomationProperties.Name="Tint strength" IsThumbToolTipEnabled="False" />
                    <TextBlock Grid.Column="2" Style="{StaticResource Value}" Text="{x:Bind Percent(S.TintOpacity), Mode=OneWay}" />
                </Grid>

                <TextBlock Text="Accent" Style="{StaticResource Section}" />
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Use my Windows accent color" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="For the equalizer, progress bars and Focus label" Style="{StaticResource RowDesc}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" OnContent="On" OffContent="Off" MinWidth="0" IsOn="{x:Bind S.FollowAccent, Mode=TwoWay}"
                                  AutomationProperties.Name="Use my Windows accent color" />
                </Grid>
                <Grid Style="{StaticResource Row}" Visibility="{x:Bind Hidden(S.FollowAccent), Mode=OneWay}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Accent color" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                    <StackPanel x:Name="Accents" Grid.Column="1" Orientation="Horizontal" Spacing="6" AutomationProperties.Name="Accent color" />
                </Grid>

                <TextBlock Text="Shape and text" Style="{StaticResource Section}" />
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Corner roundness, resting" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                    <Slider Grid.Column="1" Width="200" Minimum="4" Maximum="17" StepFrequency="1" VerticalAlignment="Center"
                            Value="{x:Bind S.CollapsedR, Mode=TwoWay}" AutomationProperties.Name="Corner roundness, resting" />
                    <TextBlock Grid.Column="2" Style="{StaticResource Value}" Text="{x:Bind Px(S.CollapsedR), Mode=OneWay}" />
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Corner roundness, open" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                    <Slider Grid.Column="1" Width="200" Minimum="8" Maximum="34" StepFrequency="1" VerticalAlignment="Center"
                            Value="{x:Bind S.ExpandedR, Mode=TwoWay}" AutomationProperties.Name="Corner roundness, open" />
                    <TextBlock Grid.Column="2" Style="{StaticResource Value}" Text="{x:Bind Px(S.ExpandedR), Mode=OneWay}" />
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Text size" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                    <StackPanel x:Name="TextSizes" Grid.Column="1" Orientation="Horizontal" Spacing="4" AutomationProperties.Name="Text size">
                        <ToggleButton Content="Small" Tag="0.9" Style="{StaticResource Chip}" Click="OnSize" />
                        <ToggleButton Content="Default" Tag="1" Style="{StaticResource Chip}" Click="OnSize" />
                        <ToggleButton Content="Large" Tag="1.15" Style="{StaticResource Chip}" Click="OnSize" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Motion" Style="{StaticResource Section}" />
                <!-- Steps are speed values the island's spring reads (stiffness 190, 420, 840); Instant skips the spring -->
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Open and close" Style="{StaticResource RowTitle}" />
                        <TextBlock x:Name="MotionTime" Text="Opens in about 220 ms" Style="{StaticResource RowDesc}" />
                    </StackPanel>
                    <StackPanel x:Name="SpeedSteps" Grid.Column="1" Orientation="Horizontal" Spacing="4" AutomationProperties.Name="Open and close speed">
                        <ToggleButton Content="Relaxed" Tag="14" Style="{StaticResource Chip}" Click="OnSpeed" />
                        <ToggleButton Content="Balanced" Tag="60" Style="{StaticResource Chip}" Click="OnSpeed" />
                        <ToggleButton Content="Snappy" Tag="100" Style="{StaticResource Chip}" Click="OnSpeed" />
                        <ToggleButton Content="Instant" Tag="instant" Style="{StaticResource Chip}" Click="OnSpeed" />
                    </StackPanel>
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Bounce" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="How much the island overshoots when it opens" Style="{StaticResource RowDesc}" />
                    </StackPanel>
                    <StackPanel x:Name="BounceSteps" Grid.Column="1" Orientation="Horizontal" Spacing="4" AutomationProperties.Name="Bounce">
                        <ToggleButton Content="None" Tag="0" Style="{StaticResource Chip}" Click="OnBounce" />
                        <ToggleButton Content="Subtle" Tag="40" Style="{StaticResource Chip}" Click="OnBounce" />
                        <ToggleButton Content="Playful" Tag="100" Style="{StaticResource Chip}" Click="OnBounce" />
                    </StackPanel>
                    <Button Grid.Column="2" Margin="12,0,0,0" Click="OnReplay" VerticalAlignment="Center" AutomationProperties.Name="Replay">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                            <TextBlock Text="Replay" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
