#include <winver.h>
1 ICON "statlet.ico"
// STATLET_VER_* come from ..\..\VERSION through build.cmd (rc /d), so the exe, Settings and the installer share one number.
VS_VERSION_INFO VERSIONINFO
FILEVERSION STATLET_VER_MAJOR,STATLET_VER_MINOR,STATLET_VER_PATCH,0
PRODUCTVERSION STATLET_VER_MAJOR,STATLET_VER_MINOR,STATLET_VER_PATCH,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Statlet"
      VALUE "LegalCopyright", "MIT License"
      VALUE "OriginalFilename", "statlet.exe"
      VALUE "ProductName", "Statlet"
      VALUE "FileDescription", "Statlet"
      VALUE "FileVersion", STATLET_VER_STR
      VALUE "ProductVersion", STATLET_VER_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
